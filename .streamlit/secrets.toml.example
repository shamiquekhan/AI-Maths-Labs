# Copy to .streamlit/secrets.toml for local development.
# Never commit the real file; it is excluded by .gitignore.
#
# The current dashboard does not require secrets. These keys are reserved for
# optional integrations and are read with st.secrets.get(...) only when present.

[app]
environment = "development"

[telemetry]
# Leave disabled for public deployments.
enabled = false

[integrations]
# Placeholder only. Do not put a real token in this example file.
api_base_url = "https://example.invalid"
